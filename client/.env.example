# Local development (used when VITE_API_URL is not set and import.meta.env.DEV is true)
# Optional override — create client/.env.local (gitignored) with:
# VITE_API_URL=http://localhost:5000/api

# Production (Vercel) — set in the Vercel project Environment Variables, NOT in a committed file:
# VITE_API_URL=https://productivity-analyzer-api.onrender.com/api
